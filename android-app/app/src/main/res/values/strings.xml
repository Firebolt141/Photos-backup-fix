    <string name="step_options">Options</string>
    <string name="opt_trust_dates">Trust dates already in photos</string>
    <string name="opt_trust_dates_sub">Recommended. Off = always use the date in the file name, when there is one.</string>
    <string name="opt_rename">Rename copies to their date</string>
    <string name="opt_rename_sub">2024-03-15_14-30-22.jpg instead of the original name</string>
    <string name="fix_info">For a drive already sorted into Year / Month / Day folders. Photos with no date inside get the date of the folder they\'re in, so Google Photos and galleries show them on the right day. JPEG, PNG and WebP can be updated; HEIC, RAW and video can\'t store a date this way and are left as they are.</string>
    <string name="opt_fix_wrong">Also correct wrong dates</string>
    <string name="opt_fix_wrong_sub">Photos whose date is more than a day away from their folder get the folder\'s day (time of day kept)</string>
